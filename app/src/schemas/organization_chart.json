          "type": "string",
          "title": "Art der Position",
          "examples": [
            "Büroleiter:in",
            "Pressesprecher:in",
            "Referent:in",
            "Senator:in",
            "Staatssekretär:in"
          ]
        },
        "positionStatus": {
          "type": "string",
          "title": "Zusatzbezeichnung",
          "examples": ["stellvertretend", "kommissarisch", "N.N."]
        },
        "positionWorkload": {
          "type": "string",
          "title": "Auslastung",
          "format": "int32",
          "enum": ["5", "25", "50", "75", "100"],
          "enumNames": ["5%", "25%", "50%", "75%", "100%"]
        },
        "uri": {
          "$ref": "#/definitions/uri"
        },
        "person": {
          "$ref": "#/definitions/person"
        }
      }
