    "export": {
      "title": "Export Options",
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "title": "Dateiname"
        },
        "saveExport": {
          "type": "string",
          "title": "Möchten Sie das Dokument zur erneuten Bearbeitung in einem maschinenlesbaren Format speichern oder das fertige Organigramm exportieren?",
          "default": "save",
          "enum": ["save", "export"],
          "enumNames": ["Speichern", "Exportieren"]
        }
      },
      "dependencies": {
        "saveExport": {
          "oneOf": [
            {
              "properties": {
                "saveExport": {
                  "enum": ["save"]
                }
              }
            },
            {
              "properties": {
                "saveExport": {
                  "enum": ["export"]
                },
                "includeLogo": {
                  "type": "boolean",
                  "title": "Logo beim Exportieren einbetten",
                  "default": true
                },
                "exportType": {
                  "type": "string",
                  "title": "Dateiformat",
                  "default": "pdf",
                  "enum": ["json", "png", "pdf", "rdf"],
                  "enumNames": ["JSON", "PNG", "PDF", "RDF"]
                }
              }
            }
          ]
        },
        "exportType": {
          "oneOf": [
            {
              "properties": {
                "exportType": {
                  "enum": ["json"]
                }
              }
            },
            {
              "properties": {
                "exportType": {
                  "enum": ["svg"]
                }
              }
            },
            {
              "properties": {
                "exportType": {
                  "enum": ["png"]
