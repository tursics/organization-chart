{
  "title": "Organization chart",
  "description": "Organization chart for Berlin's administration",
  "version": "0.0.1",
  "definitions": {
    "additionalProperties": false,
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "title": "Titel"
        },
        "paperSize": {
          "type": "string",
          "title": "Ausgabegröße",
          "default": "A4",
          "enum": ["A5", "A4", "A3", "A2", "A1", "A0"]
        },
        "schemaVersion": {
          "type": "string",
          "title": "Schema",
          "default": "0.0.1"
        },
        "paperOrientation": {
          "type": "string",
          "title": "Orientierung",
          "default": "landscape",
          "enum": ["landscape", "portrait"],
          "enumNames": ["Querformat", "Hochformat"]
        },
        "logo": {
          "title": "Logo",
          "type": "string",
          "format": "data-url"
        },
        "version": {
          "type": "string",
          "format": "date",
          "title": "Version"
        },
        "creator": {
          "type": "string",
          "title": "Verfasser:in"
        },
        "note": {
          "type": "string",
          "title": "Fußzeile"
        },
        "uri": {
          "$ref": "#/definitions/uri"
        }
      },
      "required": ["title"],
      "title": "Document"
    },
